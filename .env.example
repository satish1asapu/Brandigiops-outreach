# Same MongoDB access pattern as Brandigiops_backend
ENVIRONMENT=DEV
SSH_TUNNEL=true
DB_NAME=marketOps
PORT=3005

# Public base used in engageLink (no trailing slash after token path root)
# Local:  http://localhost:3005/r
# Prod:   https://your-domain.com/r
PUBLIC_REDIRECT_BASE_URL=http://localhost:3005/r

# AWS Secrets Manager (secret id: JWKSUri) — used for bastion + mongo domain
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID_CS=
AWS_SECRET_ACCESS_KEY_CS=

# Optional: skip tunnel and use a direct URI instead (only if SSH_TUNNEL is not true
# and you change app wiring). Prefer SSH_TUNNEL=true for local/dev.
# MONGO_URI=mongodb://localhost:27017/brandigiops
