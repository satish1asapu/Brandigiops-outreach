# Same MongoDB access pattern as Brandigiops_backend
ENVIRONMENT=DEV
SSH_TUNNEL=true
DB_NAME=marketOps
PORT=3005

# Public base used in engageLink (no trailing slash after token path root)
# Local:  http://localhost:3005/r
# Prod:   https://your-domain.com/r
PUBLIC_REDIRECT_BASE_URL=http://localhost:3005/

# GMB review follow-up (WhatsApp templates must be approved in Meta)
# Reminder template body: {{1}} = name, {{2}} = business name, {{3}} = review link
# Thank-you template body: {{1}} = name, {{2}} = business name
# Background jobs for existing outreach links (not triggered by saving client customers).
# Set true in production when follow-ups should run on a schedule.
OUTREACH_FOLLOWUP_CRON_ENABLED=false

REVIEW_REMINDER_HOURS=48
GMB_WHATSAPP_TEMPLATE=business_review_link
GMB_CUSTOMER_REVIEW_TEMPLATE=customer_review_request
GMB_REMINDER_TEMPLATE=business_review_reminder
GMB_THANK_YOU_TEMPLATE=business_review_thank_you

# Review detection via SerpApi (Google Maps Reviews).
# - Immediate: check when customer opens /r/:token, then every 5 min while link is "clicked"
# - Daily backup: 10:00 Asia/Kolkata for links never opened or slow reviewers
SERPAPI_KEY=
REVIEW_CHECK_DAYS=7
REVIEW_FAST_CHECK_HOURS=48

# AWS Secrets Manager — same as Brandigiops services/api (secret: BrandOps)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID_CS=
AWS_SECRET_ACCESS_KEY_CS=
AWS_SECRET_ID=BrandOps
# Optional legacy merge (services/api uses BrandOps only):
# AWS_SECRET_FALLBACK=JWKSUri
# Use 21210 when Brandigiops services/api is already using 21101
TUNNEL_LOCAL_PORT=21210

# If SSH is up but Mongoose times out, secrets may point at a dead Mongo host.
# Diagnose: node scripts/test-bastion-mongo-reach.js  (OPEN/CLOSED from bastion)
# Bypass tunnel when you have a working URI from DevOps:
# MONGO_URI=mongodb://user:pass@host:27017/marketOps?authSource=admin

# Optional: skip tunnel and use a direct URI instead (only if SSH_TUNNEL is not true
# and you change app wiring). Prefer SSH_TUNNEL=true for local/dev.
# MONGO_URI=mongodb://localhost:27017/brandigiops
